<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.budgetapp.backup.plist
  
  Install:
    1. Copy this file to ~/Library/LaunchAgents/
    2. Edit the two /path/to/your/project/ placeholders below
    3. Run: launchctl load ~/Library/LaunchAgents/com.budgetapp.backup.plist
  
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.budgetapp.backup.plist
  
  Check status:
    launchctl list | grep budgetapp
  
  View logs:
    tail -f /tmp/budgetapp_backup.log
-->
<plist version="1.0">
<dict>

    <!-- Unique label — must match filename -->
    <key>Label</key>
    <string>com.budgetapp.backup</string>

    <!-- Command to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/your/project/backup.sh</string>
    </array>

    <!-- Working directory = your project root (where .env and docker-compose.yml live) -->
    <key>WorkingDirectory</key>
    <string>/path/to/your/project</string>

    <!--
        Run weekly on Sunday at 10:00 PM.
        
        To change the day, update the Weekday value:
          0 = Sunday | 1 = Monday | 2 = Tuesday | 3 = Wednesday
          4 = Thursday | 5 = Friday | 6 = Saturday
        
        To change the time, update Hour (0-23, 24hr format) and Minute (0-59).
        Example: Saturday at 8:30 PM -> Weekday=6, Hour=20, Minute=30
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/tmp/budgetapp_backup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/budgetapp_backup.err</string>

    <!-- Run missed job if Mac was asleep at scheduled time -->
    <key>RunAtLoad</key>
    <false/>

</dict>
</plist>
